#!/bin/bash
# Stub MP7 executable for testing
# Called as: mp7 <namefile>  with cwd=model_ws
namefile="$1"
# Extract model name from namefile (e.g. model.mpsim -> model)
base="${namefile%.*}"
# Write minimal valid MP7 v7 path file
out="${base}.mppth"
cat > "$out" << 'EOF'
MODPATH_PATHLINE_FILE         7
1 1 1 1 0.0 50.0 50.0 25.0 0 0 50.0 50.0 25.0 0 1
1 1 2 1 0.1 51.0 50.0 25.0 0 0 50.0 50.0 25.0 0 1
EOF
exit 0
